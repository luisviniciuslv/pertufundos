# =============================================================================
# PERTUFUNDOS — Configuração do Fundo Coletivo Web3
# Copie este arquivo para .env na raiz (ou apps/api/.env e apps/web/.env.local)
# =============================================================================

# --- Modo de Operação ---
# STORAGE_DRIVER: "sqlite" (zero-config local para testes rápidos) ou "postgres" (produção)
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/pertufundos.sqlite
DATABASE_URL=postgresql://pertufundos:pertufundos_secret@localhost:5432/pertufundos
# Para PostgreSQL gerenciado com mTLS (ex: Square Cloud), informe o certificado Base64 ou caminho do .pem
DATABASE_SSL_CERT_BASE64=
DATABASE_SSL_CERT_PATH=

# --- Servidor Backend & Sessão de Autenticação Criptográfica ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=troque_por_uma_string_aleatoria_longa_em_producao_64_chars

# --- Cofre Multisig (Safe) & Redes EVM ---
# Chain principal de custódia/trades: 56 (BNB Chain)
PRIMARY_CHAIN_ID=56
# Chain de saída para P2P.me (Pix): 8453 (Base)
EXIT_CHAIN_ID=8453
SAFE_ADDRESS=0x1111111111111111111111111111111111111111
SAFE_THRESHOLD=3
SAFE_API_KEY=

# RPC Endpoints (use Alchemy/QuickNode em produção para maior estabilidade)
BSC_RPC_URL=https://bsc-dataseed.binance.org
BASE_RPC_URL=https://mainnet.base.org

# --- Ondo Finance Oracle (Opcional: endereço do SyntheticSharesOracle na BNB Chain) ---
ONDO_SHARES_ORACLE_ADDRESS=

# --- OKX Onchain OS (DEX Aggregator v6 & Cross-Chain v5) ---
# Caso vazio, o sistema opera em modo simulação determinística para desenvolvimento local
OKX_BASE_URL=https://web3.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# Proteções Operacionais de Trade
MAX_SLIPPAGE_PERCENT=0.5
MAX_PRICE_IMPACT_PERCENT=1.5
ENFORCE_US_MARKET_HOURS=true

# --- Monitoramento de Depósitos (Alchemy Address Activity Webhook) ---
ALCHEMY_WEBHOOK_SIGNING_KEY=

# --- Notificações para o Grupo (Opcional) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Variáveis Públicas do Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SAFE_ADDRESS=0x1111111111111111111111111111111111111111
NEXT_PUBLIC_SAFE_API_KEY=
NEXT_PUBLIC_PRIMARY_CHAIN_ID=56
NEXT_PUBLIC_EXIT_CHAIN_ID=8453
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
